# Required upstream the proxy talks to. Any [OI]-compatible base URL.
PACE_UPSTREAM=https://api.example.com/v1

# Upstream credential. The proxy attaches this; callers send anything.
PACE_API_KEY=

# Seconds between requests on the throttled tier. Measure your own provider's
# cliff (see README) — 2.8 is what one free tier happened to need.
PACE_FREE_GAP=2.8

# Gap for metered/premium models. Usually 0: they have no cooldown, and pacing
# them is pure added latency.
PACE_PAID_GAP=0

# Provider concurrency cap, minus headroom for callers you don't control.
PACE_MAX_CONCURRENT=4

# Fallback order. First entry that answers wins.
PACE_LADDER=model-a:free,model-b:free

# Retries for a cooldown rejection before moving down the ladder.
PACE_COOLDOWN_RETRIES=2

# Extra wait added after a cooldown rejection.
PACE_COOLDOWN_MARGIN=1.0

# Body substrings meaning "throttled, wait" vs "this model is spent".
PACE_COOLDOWN_MARKERS=rate limit exceeded,too many concurrent requests,rate limit reached,quota exceeded,slow down
PACE_EXHAUSTED_MARKERS=daily limit reached,no permanent credit,insufficient quota,out of credits

# Substring marking a model as metered.
PACE_PAID_MARKER=:metered

# Some providers sit behind a WAF that allowlists browser User-Agents.
# PACE_USER_AGENT=Mozilla/5.0 ...

PACE_LOG_LEVEL=INFO
